# The environment to run the application in
NODE_ENV=development

# --- Smart contract API ------------------------------------------------------
# JSON-RPC endpoint the API reads from / broadcasts to.
# Local Hardhat node: http://127.0.0.1:8545 (CHAIN_ID=31337)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CHAIN_NAME=localhost
BLOCK_EXPLORER_URL=

# Deployed contract addresses for the network above.
REAL_ESTATE_ADDRESS=
ESCROW_ADDRESS=

# Optional. Only needed for platform-signed writes (POST /real-estate/mint).
# User-facing writes use the /prepare endpoints and are signed in the browser.
# NEVER commit a real key.
SERVER_WALLET_PRIVATE_KEY=

# Confirmations to wait for before a write endpoint responds.
TX_CONFIRMATIONS=1

# Allowed browser origin(s) for CORS, comma separated.
CLIENT_URL=http://localhost:3000
